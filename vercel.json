{
  "regions": [
    "sin1"
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)data' ':(exclude)scripts' ':(exclude).github' ':(exclude)*.md' ':(exclude)LICENSE' ':(exclude)NOTICE'"
}
