# Free NASA FIRMS key for fire hotspots: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Optional data.gov.sg API key for higher rate limits: https://data.gov.sg
DATA_GOV_SG_API_KEY=
# Free OpenAQ key for community air sensors on the map: https://explore.openaq.org/register
OPENAQ_API_KEY=
# Set to 1 to render demo data (offline development)
HAZE_MOCK=
# Telegram channel link (https://t.me/...) to show a "Get alerts" button
NEXT_PUBLIC_ALERTS_URL=
# Bot token and channel id used by scripts/alert.ts to post alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Feedback form by email: free Resend key (https://resend.com) and the address that receives it
RESEND_API_KEY=
FEEDBACK_EMAIL=
# Or by Telegram: your own chat id with the bot
FEEDBACK_CHAT_ID=
# Site link in alert messages (default https://hazelah.app)
SITE_URL=

# Optional LTA DataMall key (about 90 traffic cameras instead of 8): https://datamall.lta.gov.sg
LTA_DATAMALL_KEY=

# Optional Windy webcams API key (free tier): https://api.windy.com/keys
WINDY_WEBCAMS_KEY=

# Free AQICN (World Air Quality Index Project) token for the US AQI stations on the map: https://aqicn.org/data-platform/token/
WAQI_TOKEN=
