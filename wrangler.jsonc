// The site Worker (vinext). The separate NEA refresh Worker has its own config in workers/nea-refresh.
//
// Secrets are not in this file. Upload each with `npx wrangler secret put <NAME>`:
//   FIRMS_MAP_KEY, OPENAQ_API_KEY, WAQI_TOKEN, WINDY_WEBCAMS_KEY, REFRESH_SECRET, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, FEEDBACK_CHAT_ID
// and, optionally, DATA_GOV_SG_API_KEY.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haze-lah",
  // Cloudflare rejects a date in the future.
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "workers_dev": true,
  // The main address, and www.hazelah.app, which next.config.ts redirects to it (permanent, path and query kept).
  "routes": [
    { "pattern": "hazelah.app", "custom_domain": true },
    { "pattern": "www.hazelah.app", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    // Everything runs the Worker except the hashed build files and the static icons (public/icons, apple-icon.png, icon.svg; headers in public/_headers).
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*", "!/icons/*.png", "!/apple-icon.png", "!/icon.svg"]
  },
  // The data cache (ISR pages, unstable_cache and revalidateTag) behind kvDataAdapter() in vite.config.ts: namespace haze-lah-cache.
  // Retired with the 1.14.4 rollback: the response store's Durable Object namespace, kept as a tombstone so deploys reconcile.
  "exports": { "CacheMetadata": { "type": "durable-object", "state": "deleted" } },
  "kv_namespaces": [{ "binding": "VINEXT_KV_CACHE", "id": "48f28b2a5e24498fb3fe8091c06e5594" }],
  // The site's private data (globe history, readings archive, forecast archive, accuracy, alert state): bucket haze-lah-data, not public.
  // src/lib/dataStore.ts is the only code that touches it; the browser gets the globe's history files through /data/history/.
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "haze-lah-data" }]
}
